# Normalize line endings across OSes (prevents CRLF/LF churn on Windows)
* text=auto eol=lf

# Explicit text types
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.xml    text eol=lf
*.txt    text eol=lf

# Binary assets — never touch line endings or try to diff
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.docx   binary
*.woff   binary
*.woff2  binary
